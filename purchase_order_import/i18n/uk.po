#. module: purchase_order_import
#: model_terms:ir.ui.view,arch_db:purchase_order_import.purchase_order_response_import_form
msgid "if the status code is Accepted: confirm the PO and create the picking"
msgstr ""
"якщо код статусу «Прийнято»: підтвердити замовлення на закупівлю та створити"
" переміщення"

#. module: purchase_order_import
#: model_terms:ir.ui.view,arch_db:purchase_order_import.purchase_order_response_import_form
