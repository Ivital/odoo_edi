#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
msgid "(fixed)"
msgstr "(фіксований)"

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
msgid "<b>Notes in file %s:</b>"
msgstr "<b>Примітки у файлі %s:</b>"

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
msgid "<b>Notes in imported document:</b>"
msgstr "<b>Примітки в імпортованому документі:</b>"

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
msgid ""
"<p>Odoo couldn't find any unit of measure corresponding to the following "
"information extracted from the business document:</p><ul><li>UNECE code: "
"%(code)s</li><li>Name of the unit of measure: %(name)s</li></ul><p>So the "
"unit of measure 'Unit(s)' has been used. <em>You may have to change it "
"manually.</em></p>"
msgstr ""
"<p>Odoo не вдалося знайти одиницю вимірювання, що відповідає таким даним, "
"витягнутим із бізнес-документа:</p><ul><li>Код UNECE: %(code)s</li><li>Назва"
" одиниці вимірювання: %(name)s</li></ul><p>Тому використано одиницю "
"вимірювання 'Одиниця(і)'. <em>Можливо, її доведеться змінити "
"вручну.</em></p>"

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
msgid ""
"<p>The UNECE code %(code)s was used to describe the unit of measure but this"
" UNECE code was not found on an existing unit of measure: you should check "
"the UNECE codes on the existing unit of measure and, if necessary, create "
"the missing unit of measure and set the UNECE code on it.</p>"
msgstr ""
"<p>Код UNECE %(code)s було використано для опису одиниці вимірювання, але "
"такого коду UNECE не знайдено в наявних одиницях вимірювання. Перевірте коди"
" UNECE наявних одиниць вимірювання та, за потреби, створіть відсутню одиницю"
" вимірювання й установіть для неї код UNECE.</p>"

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
msgid ""
"Approximate match: account %(account)s has been matched with account "
"%(matched_account)s"
msgstr ""
"Приблизний збіг: рахунок %(account)s зіставлено з рахунком "
"%(matched_account)s"

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
msgid "Could not find any Incoterm in Odoo corresponding to '%s'"
msgstr "Не вдалося знайти в Odoo Incoterm, що відповідає «%s»"

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
msgid ""
"For product '%(product)s', the unit of measure is %(uom_product)s on the "
"existing line, but it is %(uom_imported)s on the imported line.We don't "
"support this scenario for the moment, so <b>the lines haven't been "
"updated</b>."
msgstr ""
"Для товару '%(product)s' в наявному рядку одиниця вимірювання — "
"%(uom_product)s, а в імпортованому рядку — %(uom_imported)s. Наразі цей "
"сценарій не підтримується, тому <b>рядки не було оновлено</b>."

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
msgid "IBAN <b>%s</b> is not valid, so it has been ignored."
msgstr "IBAN <b>%s</b> недійсний, тому його проігноровано."

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
msgid "ID {id} of '{model}' doesn't exist in Odoo."
msgstr "ID {id} моделі «{model}» не існує в Odoo."

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
msgid "Import Warnings:"
msgstr "Попередження імпорту:"

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
msgid "Missing VAT number on company '%s'."
msgstr "У компанії '%s' відсутній номер ПДВ."

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
msgid "No currency specified, so Odoo used the company currency (%s)"
msgstr "Валюту не вказано, тому Odoo використав валюту компанії (%s)"

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
msgid ""
"Odoo couldn't find any account corresponding to the following information extracted from the business document:\n"
"Account code: %s"
msgstr ""
"Odoo не вдалося знайти рахунок за такою інформацією, вилученою з господарського документа:\n"
"Код рахунку: %s"

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
msgid ""
"Odoo couldn't find any analytic account corresponding to the following information extracted from the business document:\n"
"Analytic account code: %s"
msgstr ""
"Odoo не вдалося знайти аналітичний рахунок за такою інформацією з господарського документа:\n"
"Код аналітичного рахунку: %s"

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
msgid ""
"Odoo couldn't find any journal corresponding to the following information extracted from the business document:\n"
"Journal code: %s"
msgstr ""
"Odoo не вдалося знайти журнал за такою інформацією, вилученою з господарського документа:\n"
"Код журналу: %s"

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
msgid ""
"Odoo couldn't find any tax with 'Tax Application' = '%(tax)s' and 'Tax Included in Price' = '%(price)s' which correspond to the following information extracted from the business document:\n"
"UNECE Tax Type code: %(tax_type)s\n"
"UNECE Tax Category code: %(tax_cat)s\n"
"UNECE Due Date code: %(tax_due_date)s\n"
"Tax amount: %(amount)s %(amount_type)s"
msgstr ""
"Odoo не вдалося знайти податок із 'Застосування податку' = '%(tax)s' і 'Податок включено в ціну' = '%(price)s', який відповідає таким даним, витягнутим із бізнес-документа:\n"
"Код типу податку UNECE: %(tax_type)s\n"
"Код категорії податку UNECE: %(tax_cat)s\n"
"Код дати сплати UNECE: %(tax_due_date)s\n"
"Сума податку: %(amount)s %(amount_type)s"

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
msgid ""
"One of the imported lines doesn't have any product, so <b>the lines haven't "
"been updated</b>."
msgstr ""
"Один з імпортованих рядків не має товару, тому <b>рядки не оновлено</b>."

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
msgid ""
"The %(label)s has been identified by the domain name '%(email_domain)s' so "
"please check carefully that the %(label)s is correct."
msgstr ""
"%(label)s визначено за доменним ім’ям «%(email_domain)s», тому уважно "
"перевірте правильність %(label)s."

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
msgid ""
"The VAT number of the customer written in the business document "
"(%(parsed_vat)s) doesn't match the VAT number of the company '%(company)s' "
"(%(vat)s) in which you are trying to import this document."
msgstr ""
"Номер ПДВ клієнта, указаний у бізнес-документі (%(parsed_vat)s), не "
"відповідає номеру ПДВ компанії '%(company)s' (%(vat)s), до якої ви "
"намагаєтеся імпортувати цей документ."

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
msgid "The XMLID '%s' doesn't exist in Odoo."
msgstr "XMLID «%s» не існує в Odoo."

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
msgid ""
"The analysis of the business document returned '%(code)s' as the country "
"code to find the related currency. But the country '%(name)s' doesn't have "
"any related currency configured in Odoo."
msgstr ""
"Аналіз бізнес-документа повернув '%(code)s' як код країни для пошуку "
"відповідної валюти. Але для країни '%(name)s' в Odoo не налаштовано "
"пов’язаної валюти."

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
msgid ""
"The analysis of the business document returned '%(code)s' as the currency "
"symbol or ISO code. But there are none or several currencies with the "
"symbol/ISO code in Odoo."
msgstr ""
"Аналіз бізнес-документа повернув '%(code)s' як символ валюти або код ISO. "
"Але в Odoo немає жодної або є кілька валют із таким символом/кодом ISO."

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
msgid ""
"The analysis of the business document returned '%s' as country code. But "
"there are no country with that code in Odoo."
msgstr ""
"Аналіз господарського документа повернув «%s» як код країни, але в Odoo "
"немає країни з таким кодом."

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
msgid ""
"The analysis of the business document returned '%s' as the country code to "
"find the related currency. But there is no country with that code in Odoo."
msgstr ""
"Аналіз господарського документа повернув «%s» як код країни для пошуку "
"пов’язаної валюти, але в Odoo немає країни з таким кодом."

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
msgid ""
"The analysis of the business document returned '%s' as the currency ISO "
"code. But there are no currency with that code in Odoo."
msgstr ""
"Аналіз господарського документа повернув «%s» як ISO-код валюти, але в Odoo "
"немає валюти з таким кодом."

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
msgid ""
"The analysis of the business document returned '%s' as the currency symbol. "
"But there are none or several currencies with that symbol in Odoo."
msgstr ""
"Аналіз господарського документа повернув «%s» як символ валюти, але в Odoo "
"немає жодної або є кілька валют із таким символом."

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
msgid ""
"The analysis of the business document returned <b>IBAN %(iban)s</b> as bank "
"account, but there is no such bank account in Odoo linked to partner <a "
"href=# data-oe-model=res.partner data-oe-id=%(partner_id)d>%(partner)s</a> "
"and the option to automatically create bank accounts upon import is "
"disabled."
msgstr ""
"Аналіз бізнес-документа повернув <b>IBAN %(iban)s</b> як банківський "
"рахунок, але в Odoo немає такого банківського рахунку, пов’язаного з "
"партнером <a href=# data-oe-model=res.partner data-oe-"
"id=%(partner_id)d>%(partner)s</a>, а опцію автоматичного створення "
"банківських рахунків під час імпорту вимкнено."

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
msgid ""
"The bank account <b>IBAN %(iban)s</b> has been automatically added on the "
"supplier <a href=# data-oe-model=res.partner data-oe-"
"id=%(partner_id)d>%(partner)s</a>"
msgstr ""
"Банківський рахунок <b>IBAN %(iban)s</b> автоматично додано постачальнику <a"
" href=# data-oe-model=res.partner data-oe-id=%(partner_id)d>%(partner)s</a>"

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
msgid ""
"The existing line '%s' doesn't have any product, so <b>the lines haven't "
"been updated</b>."
msgstr "Наявний рядок «%s» не має товару, тому <b>рядки не оновлено</b>."

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
msgid ""
"The product '%s' is used on several existing lines, so <b>the lines haven't "
"been updated</b>."
msgstr ""
"Товар «%s» використовується в кількох наявних рядках, тому <b>рядки не "
"оновлено</b>."

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
msgid ""
"The product '%s' is used on several imported lines, so <b>the lines haven't "
"been updated</b>."
msgstr ""
"Товар «%s» використовується в кількох імпортованих рядках, тому <b>рядки не "
"оновлено</b>."

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
msgid ""
"The record '{record}' is an instance of '{record_model}', not of "
"'{target_model}'."
msgstr ""
"Запис '{record}' є екземпляром '{record_model}', а не '{target_model}'."

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
msgid "customer"
msgstr "клієнт"

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
msgid "partner"
msgstr "партнер"

#. module: base_business_document_import
#. odoo-python
#: code:addons/base_business_document_import/models/business_document_import.py:0
msgid "supplier"
msgstr "постачальник"
