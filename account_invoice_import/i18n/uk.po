#: code:addons/account_invoice_import/wizard/account_invoice_import.py:0
msgid "Import of file %s"
msgstr "Імпорт файлу %s"

#. module: account_invoice_import
#. odoo-python
#: code:addons/account_invoice_import/wizard/account_invoice_import.py:0
msgid "Invoice '%(filename)s' already exists in Odoo: %(existing_inv)s."
msgstr "Рахунок «%(filename)s» уже існує в Odoo: %(existing_inv)s."

#. module: account_invoice_import
#. odoo-python
#: code:addons/account_invoice_import/wizard/account_invoice_import.py:0
msgid ""
"Matched UoM is <strong>%(matched_uom)s</strong>, but this UoM doesn't belong"
" to the same category as UoM <strong>%(product_uom)s</strong> configured on "
"product <em>%(product)s</em>. So Odoo has set the UoM of the product "
"(%(product_uom)s)."
msgstr ""
"Зіставлена одиниця вимірювання — <strong>%(matched_uom)s</strong>, але вона "
"не належить до тієї самої категорії, що й одиниця вимірювання "
"<strong>%(product_uom)s</strong>, налаштована для товару "
"<em>%(product)s</em>. Тому Odoo встановила одиницю вимірювання товару "
"(%(product_uom)s)."

#. module: account_invoice_import
#. odoo-python
#: code:addons/account_invoice_import/wizard/account_invoice_import.py:0
msgid "No invoice created."
msgstr "Рахунок не створено."

#. module: account_invoice_import
#. odoo-python
#: code:addons/account_invoice_import/wizard/account_invoice_import.py:0
msgid "No journal with type %(journal_type)s in company %(company)s."
msgstr "У компанії %(company)s немає журналу типу %(journal_type)s."

#. module: account_invoice_import
#. odoo-python
#: code:addons/account_invoice_import/wizard/account_invoice_import.py:0
