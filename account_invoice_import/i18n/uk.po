"Odoo failed to read the XML invoice '%(filename)s'. Did you install the Odoo"
" module to support this type of file?"
msgstr ""
"Odoo не вдалося прочитати XML-рахунок «%(filename)s». Чи встановлено модуль "
"Odoo для підтримки цього типу файлу?"

#. module: account_invoice_import
#. odoo-python
#: code:addons/account_invoice_import/wizard/account_invoice_import.py:0
msgid "Only the date format 102 is supported."
msgstr "Підтримується лише формат дати 102."

#. module: account_invoice_import
#. odoo-python
