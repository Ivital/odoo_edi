"Partner <a href=# data-oe-model=res.partner data-oe-"
"id=%(partner_id)s>%(partner_name)s</a> has been created via the wizard "
"<em>Create or update partner</em>."
msgstr ""
"Партнера <a href=# data-oe-model=res.partner data-oe-"
"id=%(partner_id)s>%(partner_name)s</a> створено через майстер <em>Створити "
"або оновити партнера</em>."

#. module: account_invoice_import
#. odoo-python
#: code:addons/account_invoice_import/wizard/account_invoice_import_partner_create.py:0
msgid ""
"Partner <a href=# data-oe-model=res.partner data-oe-"
"id=%(partner_id)s>%(partner_name)s</a> has been set via the wizard "
"<em>Create or Update Partner</em>. The partner has been updated."
msgstr ""
"Партнера <a href=# data-oe-model=res.partner data-oe-"
"id=%(partner_id)s>%(partner_name)s</a> встановлено за допомогою майстра "
"<em>Створити або оновити партнера</em>. Партнера оновлено."

#. module: account_invoice_import
#. odoo-python
#: code:addons/account_invoice_import/models/res_partner.py:0
